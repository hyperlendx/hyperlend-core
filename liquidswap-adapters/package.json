{
  "name": "liquidswap-adapters",
  "packageManager": "yarn@4.5.1",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy/base-liquid-swap-buy-adapter.js",
    "deploy:testnet": "hardhat run scripts/deploy/base-liquid-swap-buy-adapter.js --network hyperEVMTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy/base-liquid-swap-buy-adapter.js --network hyperEVM",
    "deploy:simplified": "hardhat run scripts/deploy-simplified.js",
    "deploy:simplified:testnet": "hardhat run scripts/deploy-simplified.js --network hyperEVMTestnet",
    "deploy:factory": "hardhat run scripts/deploy-factory.js",
    "deploy:factory:testnet": "hardhat run scripts/deploy-factory.js --network hyperEVMTestnet",
    "deploy:with-config": "hardhat run scripts/deploy-with-config.js",
    "deploy:all": "hardhat run scripts/deploy-all-adapters.js",
    "deploy:repay": "hardhat run scripts/deploy-liquidswap-repay-adapter.js",
    "deploy:with-config:testnet": "hardhat run scripts/deploy-with-config.js --network hyperEVMTestnet",
    "deploy:with-config:mainnet": "hardhat run scripts/deploy-with-config.js --network hyperEVM",
    "deploy:all:testnet": "hardhat run scripts/deploy-all-adapters.js --network hyperEVMTestnet",
    "deploy:all:mainnet": "hardhat run scripts/deploy-all-adapters.js --network hyperEVM",
    "verify": "hardhat verify",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.24.0",
    "hyperlend-core": "file:../"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-ignition": "^0.15.11",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.11",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "chai": "^4.5.0",
    "ethers": "^6.14.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.16",
    "typechain": "^8.3.2"
  }
}
